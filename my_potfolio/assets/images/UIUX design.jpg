    <script>
        $('.context-header-key').each(function () {
            let $parent = $(this).parent();
            while ($parent.length && !$parent.is('h1, h2, h3, h4, h5, h6')) {
                $parent = $parent.parent();
            }
            if ($parent.length) {
                $parent.addClass('context-header');
            }
        });
    </script>
