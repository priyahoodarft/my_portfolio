# Copy this file to ".env" and fill in your real values.
# .env is gitignored so your password is never committed.

# Your Gmail address (also the address messages are sent to)
EMAIL_USER=hoodapriyal0@gmail.com

# Gmail App Password (NOT your normal login password).
# Create one at: Google Account > Security > App Passwords
EMAIL_PASS=your-16-char-app-password

# Optional: send received messages to a different address
# RECEIVER=someone@example.com
